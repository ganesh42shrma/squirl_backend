  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "redis": "^6.3.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
