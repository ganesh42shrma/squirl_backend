{
  "name": "squirl-backend",
  "version": "1.0.0",
  "description": "Lightweight personal finance tracker API",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed-defaults.js",
    "db:key": "node src/scripts/db-key.js",
    "llm": "sh scripts/llm.sh",
    "test:family": "node scripts/test-family.js",
    "test:reset": "node scripts/test-reset.js",
    "test:dashboard": "node scripts/test-dashboard.js",
    "test:imports": "node scripts/test-imports.js",
    "test:transactions": "node scripts/test-transactions.js",
    "test:ledger-pagination": "node scripts/test-ledger-pagination.js",
    "test:summary": "node scripts/test-summary.js"
