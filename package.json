{
  "name": "squirl-backend",
  "version": "1.0.0",
  "description": "Lightweight personal finance tracker API",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:local": "node scripts/dev-local.js",
    "dev:payment": "node scripts/dev-local.js --payment",
    "test:local-dev": "node scripts/test-local-dev.js",
    "release:plan": "node deployment/publish.js --dry-run",
    "release:publish": "node deployment/publish.js",
    "deploy:install": "node deployment/install.js",
    "test:deploy": "node scripts/test-deploy.js",
    "seed": "node src/scripts/seed-defaults.js",
    "db:key": "node src/scripts/db-key.js",
    "llm": "sh scripts/llm.sh",
    "test:family": "node scripts/test-family.js",
    "test:reset": "node scripts/test-reset.js",
    "test:dashboard": "node scripts/test-dashboard.js",
    "test:imports": "node scripts/test-imports.js",
    "test:transactions": "node scripts/test-transactions.js",
    "test:ledger-pagination": "node scripts/test-ledger-pagination.js",
    "test:summary": "node scripts/test-summary.js",
    "test:goals": "node scripts/test-goals.js",
    "test:feeds": "node scripts/test-feeds.js",
    "test:tasks": "node scripts/test-tasks.js",
    "push:keys": "node scripts/push-keys.js",
    "test:notifications": "node scripts/test-notifications.js",
    "test:private-serving": "node scripts/test-private-serving.js",
    "test:commitments": "node scripts/test-commitments.js",
    "test:quotes": "node scripts/test-quotes.js",
    "test:sms": "node scripts/test-sms.js",
    "test:payment-prompts": "node scripts/test-payment-prompts.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "openai": "^7.54.0",
    "redis": "^6.3.1",
    "web-push": "^4.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
