NODE_ENV=development
PORT=4000
DB_PATH=/Volumes/mushroom/squirl/squirl.db
# DB_KEY=   leave unset to use the macOS Keychain (npm run db:key). Never store the key on the drive.
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
PARSER_SERVICE_URL=http://127.0.0.1:8000
PARSER_TIMEOUT_MS=60000
# Optional local LLM (OpenAI-compatible). Default: Squirl's Ollama server from `npm run llm`
LLM_URL=http://127.0.0.1:11435
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_MS=300000
# Sessions (Redis). SESSION_SECRET is optional: by default it's derived from the database key.
REDIS_URL=redis://127.0.0.1:6379
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
APP_URL=http://localhost:5173
