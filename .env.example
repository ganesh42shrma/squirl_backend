NODE_ENV=development
PORT=4000
DB_PATH=/Volumes/mushroom/squirl/squirl.db
# Set true on the serving desktop after placing the existing database at DB_PATH.
DB_MUST_EXIST=false
# DB_KEY=   Linux: set to the existing database key from your Mac or backup.
# macOS: leave unset to use the Keychain (npm run db:key creates keys for NEW databases only).
# Keep this .env on the computer's internal disk, never on the database drive.
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
PARSER_SERVICE_URL=http://127.0.0.1:8000
PARSER_TIMEOUT_MS=60000
# Optional local LLM (OpenAI-compatible). Default: Squirl's Ollama server from `npm run llm`
LLM_URL=http://127.0.0.1:11435
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_MS=300000
# Sessions (Redis). SESSION_SECRET is optional: by default it's derived from the database key.
REDIS_URL=redis://127.0.0.1:6379
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
APP_URL=http://localhost:5173

# Private phone access: build the frontend, then serve it and /api from this backend.
HOST=127.0.0.1
SERVE_FRONTEND=false
# Enable only behind the local Tailscale Serve HTTPS proxy, with COOKIE_SECURE=true.
TRUST_PROXY_LOOPBACK=false
# Generate on the serving desktop: npm run push:keys -- mailto:your-email@example.com
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# Photo attachments (receipts etc.), optional. Off unless BOTH MEDIA_DIR and MEDIA_KEY are valid.
# Images are encrypted by the app and stored here, on the computer's INTERNAL disk: never on the database
# drive (a folder inside the database's folder is refused). See deployment/MEDIA.md.
# MEDIA_DIR=/home/your-user/squirl-media
# Exactly 32 random bytes, base64 or 64 hex characters:  openssl rand -base64 32
# BACK THIS UP somewhere other than this computer: without it every stored image is unrecoverable.
# MEDIA_KEY=
# Per photo, in bytes (default 8 MiB). The browser shrinks photos before upload, so this is a safety net.
# MEDIA_MAX_BYTES=8388608
# Total stored per account, in bytes (default 5 GiB).
# MEDIA_USER_QUOTA_BYTES=5368709120
# Photos per transaction, task or goal (default 10).
# MEDIA_MAX_PER_OWNER=10
# Optional encrypted copy in S3-compatible storage (Cloudflare R2, Backblaze B2, ...). All four are required
# to switch it on; the bucket only ever receives encrypted blobs. Use an https:// endpoint.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# true = https://endpoint/bucket/key (R2, B2, MinIO), false = https://bucket.endpoint/key
# S3_PATH_STYLE=true
