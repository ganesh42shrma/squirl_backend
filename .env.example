NODE_ENV=development
PORT=4000
DB_PATH=/Volumes/mushroom/squirl/squirl.db
# Set true on the serving desktop after placing the existing database at DB_PATH.
DB_MUST_EXIST=false
# DB_KEY=   Linux: set to the existing database key from your Mac or backup.
# macOS: leave unset to use the Keychain (npm run db:key creates keys for NEW databases only).
# Keep this .env on the computer's internal disk, never on the database drive.
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
PARSER_SERVICE_URL=http://127.0.0.1:8000
PARSER_TIMEOUT_MS=60000
# Optional local LLM (OpenAI-compatible). Default: Squirl's Ollama server from `npm run llm`
LLM_URL=http://127.0.0.1:11435
LLM_MODEL=qwen3.5:9b
LLM_TIMEOUT_MS=300000
# Sessions (Redis). SESSION_SECRET is optional: by default it's derived from the database key.
REDIS_URL=redis://127.0.0.1:6379
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
APP_URL=http://localhost:5173

# Private phone access: build the frontend, then serve it and /api from this backend.
HOST=127.0.0.1
SERVE_FRONTEND=false
# Enable only behind the local Tailscale Serve HTTPS proxy, with COOKIE_SECURE=true.
TRUST_PROXY_LOOPBACK=false
# Generate on the serving desktop: npm run push:keys -- mailto:your-email@example.com
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
